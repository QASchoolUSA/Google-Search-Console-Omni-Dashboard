{
  "name": "gsc-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "dev:worker": "npm run build && wrangler dev",
    "d1:create": "wrangler d1 create gsc-database",
    "d1:migrate:local": "wrangler d1 execute gsc-database --local --file=schema.sql",
    "d1:migrate:remote": "wrangler d1 execute gsc-database --remote --file=schema.sql",
    "lint": "oxlint",
    "test": "npx tsx test/parity_math.test.ts && npx tsx test/integrity.test.ts && npx tsx test/genai.test.ts && npx tsx test/indexing.test.ts"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "lucide-solid": "^1.59.0",
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261018.1",
    "@types/node": "^24.13.3",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-solid": "^2.11.14",
    "wrangler": "^4.151.1"
  }
}
